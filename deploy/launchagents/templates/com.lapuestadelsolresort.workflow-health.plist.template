<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lapuestadelsolresort.workflow-health</string>
  <key>ProgramArguments</key><array><string>__PYTHON_BIN__</string><string>__SOCIALSOL_ROOT__/automation/workflow_health.py</string></array>
  <key>StartInterval</key><integer>300</integer><key>RunAtLoad</key><true/>
  <key>WorkingDirectory</key><string>__SOCIALSOL_ROOT__</string>
  <key>EnvironmentVariables</key><dict>
    <key>SOCIALSOL_ROOT</key><string>__SOCIALSOL_ROOT__</string>
    <key>SOCIALSOL_SECRETS_DIR</key><string>__SOCIALSOL_SECRETS_DIR__</string>
    <key>OPENCLAW_SLACK_ACCOUNT</key><string>__OPENCLAW_SLACK_ACCOUNT__</string>
    <key>RESORT_OPS_ALERTS_CHANNEL</key><string>__RESORT_OPS_ALERTS_CHANNEL__</string>
  </dict>
  <key>StandardOutPath</key><string>__SOCIALSOL_ROOT__/logs/workflow-health.log</string>
  <key>StandardErrorPath</key><string>__SOCIALSOL_ROOT__/logs/workflow-health.error.log</string>
</dict></plist>
