<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lapuestadelsolresort.kapital-tests</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SOCIALSOL_ROOT__/accounting/run_weekly_tests.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/kapital-tests.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/kapital-tests.err</string>
</dict>
</plist>
