# Repository paths
SOCIALSOL_ROOT=/opt/socialsol
SOCIALSOL_SECRETS_DIR=/opt/socialsol/secrets
DB_PATH=/opt/socialsol/crm/data/crm.db

# Local integrations
OPENCLAW_BIN=/opt/homebrew/bin/openclaw
OPENCLAW_SLACK_ACCOUNT=replace-with-account-name
RESORT_SOCIAL_CHANNEL=replace-with-slack-channel-id
PROSPECTOR_SLACK_CHANNEL=replace-with-slack-channel-id
GMAIL_IMPERSONATE_USER=replace-with-workspace-user@example.com
RESORT_SENDER_EMAIL=replace-with-sender@example.com
GTKU_GOOGLE_ACCOUNT=replace-with-google-drive-user@example.com
POSTIZ_INTEGRATION_ID=replace-with-postiz-integration-id
CLOUDFLARE_TUNNEL_NAME=replace-with-tunnel-name
META_INSTAGRAM_ID=replace-with-instagram-business-account-id

# Public endpoints
PUBLIC_CRM_ORIGIN=https://webhook.example.com
TWILIO_WEBHOOK_URL=https://webhook.example.com/webhook/twilio-whatsapp/webhook

# Optional direct environment credentials.
# Production uses mode-600 JSON files under SOCIALSOL_SECRETS_DIR instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
