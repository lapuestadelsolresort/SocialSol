    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-family: 'DM Sans', sans-serif; color: #3d2e1e; background: #faf8f5; }
      .font-display { font-family: 'Cormorant Garamond', serif; }

      /* Sand palette */
      .text-sand-800 { color: #3d2e1e; }
      .text-sand-600 { color: #6b5744; }
      .text-sand-500 { color: #8a6f5a; }
      .text-sand-400 { color: #b09880; }
      .text-sand-300 { color: #c9b4a0; }
      .border-sand-200 { border-color: #e8ddd4; }
      .border-sand-100 { border-color: #f0ebe5; }

      /* Layout */
      .max-w-3xl { max-width: 48rem; }
      .mx-auto { margin-left: auto; margin-right: auto; }
      .px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }
      .py-16 { padding-top: 4rem; padding-bottom: 4rem; }
      .py-8 { padding-top: 2rem; padding-bottom: 2rem; }
      .mb-2 { margin-bottom: 0.5rem; }
      .mb-3 { margin-bottom: 0.75rem; }
      .mb-4 { margin-bottom: 1rem; }
      .mb-5 { margin-bottom: 1.25rem; }
      .mb-8 { margin-bottom: 2rem; }
      .mb-10 { margin-bottom: 2.5rem; }
      .mt-1 { margin-top: 0.25rem; }
      .mt-4 { margin-top: 1rem; }
      .mt-0\.5 { margin-top: 0.125rem; }

      /* Typography */
      .text-xs { font-size: 0.75rem; }
      .text-sm { font-size: 0.875rem; }
      .text-base { font-size: 1rem; }
      .text-lg { font-size: 1.125rem; }
      .text-2xl { font-size: 1.5rem; }
      .text-3xl { font-size: 1.875rem; }
      .text-4xl { font-size: 2.25rem; }
      .font-medium { font-weight: 500; }
      .font-normal { font-weight: 400; }
      .leading-tight { line-height: 1.25; }
      .leading-relaxed { line-height: 1.625; }
      .leading-snug { line-height: 1.375; }
      .leading-\[1\.1\] { line-height: 1.1; }
      .tracking-\[3px\] { letter-spacing: 3px; }
      .uppercase { text-transform: uppercase; }
      .underline { text-decoration: underline; }
      .text-center { text-align: center; }

      /* Colors */
      .text-white { color: #fff; }
      .text-white\/70 { color: rgba(255,255,255,0.7); }
      .text-white\/50 { color: rgba(255,255,255,0.5); }
      .bg-\[\#25D366\] { background-color: #25D366; }
      .bg-\[\#25D366\]:hover { background-color: #1fb855; }
      .fill-white { fill: #fff; }

      /* Hero */
      .hero {
        position: relative;
        width: 100%;
        height: min(85vh, 900px);
        min-height: 600px;
        overflow: hidden;
      }
      .hero img.hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 60%;
      }
      .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.28) 50%, transparent 100%);
      }
      .hero-content {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0 1.5rem 2.5rem;
        max-width: 48rem;
      }

      /* Flex helpers */
      .flex { display: flex; }
      .flex-wrap { flex-wrap: wrap; }
      .inline-flex { display: inline-flex; }
      .items-center { align-items: center; }
      .gap-2 { gap: 0.5rem; }
      .gap-2\.5 { gap: 0.625rem; }
      .gap-3 { gap: 0.75rem; }
      .gap-4 { gap: 1rem; }
      .gap-6 { gap: 1.5rem; }

      /* Grid */
      .grid { display: grid; }
      .grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
      .grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .row-span-2 { grid-row: span 2 / span 2; }

      /* Border / Radius */
      .border { border-width: 1px; border-style: solid; }
      .border-l { border-left-width: 1px; border-left-style: solid; }
      .border-t { border-top-width: 1px; border-top-style: solid; }
      .rounded-lg { border-radius: 0.5rem; }

      /* Padding for cards */
      .p-5 { padding: 1.25rem; }
      .px-7 { padding-left: 1.75rem; padding-right: 1.75rem; }
      .py-3\.5 { padding-top: 0.875rem; padding-bottom: 0.875rem; }
      .py-7 { padding-top: 1.75rem; padding-bottom: 1.75rem; }
      .pl-4 { padding-left: 1rem; }

      /* Width / sizing */
      .w-full { width: 100%; }
      .w-5 { width: 1.25rem; }
      .h-5 { height: 1.25rem; }
      .h-full { height: 100%; }
      .shrink-0 { flex-shrink: 0; }
      .aspect-square { aspect-ratio: 1/1; }
      .aspect-\[4\/3\] { aspect-ratio: 4/3; }
      .max-w-xl { max-width: 36rem; }
      .max-w-lg { max-width: 32rem; }
      .max-w-3xl { max-width: 48rem; }

      /* Object fit */
      .object-cover { object-fit: cover; }

      /* Overflow */
      .overflow-hidden { overflow: hidden; }

      /* Transition */
      .transition-colors { transition: background-color 0.15s ease; }

      /* WhatsApp button */
      .wa-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        background-color: #25D366;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.875rem 1.75rem;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: background-color 0.15s ease;
      }
      .wa-cta:hover { background-color: #1fb855; }

      /* HR */
      hr { border: none; border-top: 1px solid #e8ddd4; }

      /* Responsive */
      @media (min-width: 768px) {
        .hero-content { padding: 0 3rem 3.5rem; }
        .md\:px-12 { padding-left: 3rem; padding-right: 3rem; }
        .md\:py-20 { padding-top: 5rem; padding-bottom: 5rem; }
        .md\:text-5xl { font-size: 3rem; }
        .md\:text-\[34px\] { font-size: 34px; }
        .md\:text-3xl { font-size: 1.875rem; }
        .grid-cols-sm-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .grid-cols-sm-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }
    </style>
  </head>

  <body>

    <!-- ============================================================
         HERO
         ============================================================ -->
    <header class="hero">
      <img src="/images/hero.webp" alt="Aerial view of La Puesta del Sol resort on the Pacific cliffs, Riviera Nayarit" class="hero-bg" loading="eager" fetchpriority="high" />
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p style="font-size:11px; letter-spacing:3px; text-transform:uppercase; color:rgba(255,255,255,0.5); margin-bottom:0.5rem;">Wellness Retreats at</p>
        <h1 class="hero-headline font-display" style="font-size:clamp(2.25rem,5vw,3rem); color:#fff; font-weight:400; line-height:1.1; margin-bottom:0.75rem;">
          La Puesta del Sol
        </h1>
        <p class="hero-sub" style="font-size:1rem; color:rgba(255,255,255,0.7); margin-bottom:2rem; max-width:32rem; line-height:1.625;">
          Private beachfront resort in Riviera Nayarit, Mexico. 45 minutes from Puerto Vallarta airport.
        </p>

        <!-- Key facts -->
        <div style="display:flex; flex-wrap:wrap; gap:1.5rem; margin-bottom:2rem;">
          <div style="border-left:1px solid rgba(255,255,255,0.25); padding-left:1rem;">
            <div style="font-size:1.125rem; font-weight:500; color:#fff;">13 bedrooms</div>
            <div style="font-size:11px; color:rgba(255,255,255,0.5); margin-top:0.125rem;">6 private villas — the whole resort is yours</div>
          </div>
          <div style="border-left:1px solid rgba(255,255,255,0.25); padding-left:1rem;">
            <div style="font-size:1.125rem; font-weight:500; color:#fff;">Up to 50 guests</div>
            <div style="font-size:11px; color:rgba(255,255,255,0.5); margin-top:0.125rem;">Exclusive full-property buyout</div>
          </div>
          <div style="border-left:1px solid rgba(255,255,255,0.25); padding-left:1rem;">
            <div style="font-size:1.125rem; font-weight:500; color:#fff;">From $15K</div>
            <div style="font-size:11px; color:rgba(255,255,255,0.5); margin-top:0.125rem;">Typical 4-night wellness buyout</div>
          </div>
        </div>

        <!-- Primary CTA -->
        <a
          href="https://wa.me/15553526612?text=Hi%20Sarah%2C%20I%27m%20a%20fitness%20%26%20wellness%20event%20coordinator%20interested%20in%20hosting%20a%20retreat%20at%20La%20Puesta%20del%20Sol.%20Can%20we%20chat%3F"
          target="_blank"
          rel="noopener"
          class="wa-cta"
          data-cta="hero_whatsapp_click" data-event="hero_whatsapp_click"
        >
          <svg class="w-5 h-5 fill-white shrink-0" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.243-1.21l-.29-.18-3.054.8.82-2.99-.193-.3A7.96 7.96 0 014 12a8 8 0 1116 0 8 8 0 01-8 8z"/>
          </svg>
          Message Us on WhatsApp
        </a>
      </div>
    </header>

    <main style="max-width:48rem; margin:0 auto; padding:0 1.5rem;">

      <!-- ============================================================
           WHAT YOU GET
           ============================================================ -->
      <section style="padding:4rem 0;">
        <p style="font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#8a6f5a; margin-bottom:0.75rem;">What you get</p>
        <h2 class="font-display" style="font-size:clamp(1.875rem,4vw,34px); color:#3d2e1e; font-weight:400; line-height:1.25; margin-bottom:1.25rem;">
          The perfect retreat venue
        </h2>
        <p style="font-size:15px; color:#6b5744; line-height:1.625; margin-bottom:1rem; max-width:36rem;">
          Every wellness retreat at La Puesta del Sol is a full-property buyout. No other guests, no shared spaces. Your group has the whole resort — beachfront yoga deck, pool, six private villas, and the full staff — for the duration of your stay.
        </p>
        <p style="font-size:15px; color:#6b5744; line-height:1.625; margin-bottom:2.5rem; max-width:36rem;">
          The resort sits on 54,000 sq ft of Pacific oceanfront, providing ample outdoor space for morning yoga, meditation sessions, group workouts, and breathwork on the beach.
        </p>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:0.75rem;">
          <div style="border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.25rem;">
            <h3 style="font-size:15px; font-weight:500; color:#3d2e1e; margin-bottom:0.25rem;">6 private villas, 13 bedrooms</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">Each villa has its own kitchen and bathroom. Space for up to 50 retreat guests.</p>
          </div>
          <div style="border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.25rem;">
            <h3 style="font-size:15px; font-weight:500; color:#3d2e1e; margin-bottom:0.25rem;">Beachfront yoga &amp; fitness space</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">Ocean-facing terraces, flat beach, and open-air palapa — natural settings for yoga, meditation, and movement.</p>
          </div>
          <div style="border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.25rem;">
            <h3 style="font-size:15px; font-weight:500; color:#3d2e1e; margin-bottom:0.25rem;">Full F&amp;B service</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">On-site chef for customized nutrition plans, healthy meals, smoothies, and dietary accommodations.</p>
          </div>
          <div style="border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.25rem;">
            <h3 style="font-size:15px; font-weight:500; color:#3d2e1e; margin-bottom:0.25rem;">Outdoor adventure programming</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">On-site adventure guide for surfing, paddleboarding, snorkeling, jungle hikes, and ocean swims.</p>
          </div>
          <div style="border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.25rem;">
            <h3 style="font-size:15px; font-weight:500; color:#3d2e1e; margin-bottom:0.25rem;">On-site event coordination</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">Dedicated property manager handles logistics, scheduling, vendor coordination, and retreat operations.</p>
          </div>
          <div style="border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.25rem;">
            <h3 style="font-size:15px; font-weight:500; color:#3d2e1e; margin-bottom:0.25rem;">Private &amp; distraction-free</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">No resort noise, no other guests. Complete privacy to focus on the retreat experience.</p>
          </div>
        </div>
      </section>

      <hr style="border:none; border-top:1px solid #e8ddd4;" />

      <!-- ============================================================
           THE PROPERTY
           ============================================================ -->
      <section style="padding:4rem 0;">
        <p style="font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#8a6f5a; margin-bottom:0.75rem;">The property</p>
        <h2 class="font-display" style="font-size:clamp(1.875rem,4vw,34px); color:#3d2e1e; font-weight:400; line-height:1.25; margin-bottom:1.25rem;">
          54,000 sq ft of beachfront
        </h2>
        <p style="font-size:15px; color:#6b5744; line-height:1.625; margin-bottom:2rem; max-width:36rem;">
          Six named villas — Pearl, Turtle, Dolphin, Seahorse, Whale, and Crab — connected by winding stone pathways over garden streams. Thatched-roof architecture, ocean on three sides, mountains behind. Located in La Peñita de Jaltemba, a quiet fishing village away from the tourist corridor — ideal for deep retreat focus.
        </p>

        <!-- Photo grid: 2-column with tall left image -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; margin-bottom:0.5rem;">
          <div style="grid-row:span 2;">
            <img src="/images/couple.webp" alt="Oceanfront platform at La Puesta del Sol" style="width:100%; height:100%; object-fit:cover; border-radius:0.5rem;" loading="lazy" />
          </div>
          <div>
            <img src="/images/villa.webp" alt="Villa interior with ocean view" style="width:100%; height:100%; object-fit:cover; border-radius:0.5rem; aspect-ratio:4/3;" loading="lazy" />
          </div>
          <div>
            <img src="/images/pathway.webp" alt="Winding stone pathways connecting the villas" style="width:100%; height:100%; object-fit:cover; border-radius:0.5rem; aspect-ratio:4/3;" loading="lazy" />
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.5rem;">
          <img src="/images/food.webp" alt="Chef-prepared healthy meal at the resort" style="width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:0.5rem;" loading="lazy" />
          <img src="/images/pool.webp" alt="Pool and open-air common area" style="width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:0.5rem;" loading="lazy" />
          <img src="/images/ceremony.webp" alt="Open-air beachfront terrace" style="width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:0.5rem;" loading="lazy" />
        </div>
      </section>

      <hr style="border:none; border-top:1px solid #e8ddd4;" />

      <!-- ============================================================
           PRICING
           ============================================================ -->
      <section style="padding:4rem 0;">
        <p style="font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#8a6f5a; margin-bottom:0.75rem;">Pricing</p>
        <h2 class="font-display" style="font-size:clamp(1.875rem,4vw,34px); color:#3d2e1e; font-weight:400; line-height:1.25; margin-bottom:1.25rem;">
          Straightforward buyout pricing
        </h2>
        <p style="font-size:15px; color:#6b5744; line-height:1.625; margin-bottom:1rem; max-width:36rem;">
          You rent the entire resort for your stay. Pricing depends on group size, dates, and programming needs. Most wellness buyouts run 3–6 nights.
        </p>
        <p style="font-size:15px; color:#6b5744; line-height:1.625; margin-bottom:1rem; max-width:36rem;">
          A typical 4-night wellness retreat buyout with full F&amp;B service for 15–25 participants starts around <strong style="color:#3d2e1e;">$15,000</strong>. Larger groups and peak-season dates run higher. We'll give you an exact number after a 15-minute discovery call.
        </p>
        <p style="font-size:13px; color:#b09880; max-width:36rem;">
          Price includes lodging, all meals, and staff for the duration. Flights, external instructors, specialty equipment, and special requests are separate.
        </p>
      </section>

      <hr style="border:none; border-top:1px solid #e8ddd4;" />

      <!-- ============================================================
           HOW TO START
           ============================================================ -->
      <section style="padding:4rem 0;">
        <p style="font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#8a6f5a; margin-bottom:0.75rem;">How to start</p>
        <h2 class="font-display" style="font-size:clamp(1.875rem,4vw,34px); color:#3d2e1e; font-weight:400; line-height:1.25; margin-bottom:2rem;">
          Three steps
        </h2>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem;">
          <div style="text-align:center; border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.75rem 1.25rem;">
            <div class="font-display" style="font-size:1.875rem; color:#c9b4a0; margin-bottom:0.5rem;">1</div>
            <h3 style="font-size:14px; font-weight:500; color:#3d2e1e; margin-bottom:0.375rem;">Message us</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">WhatsApp or email. Tell us your dates, group size, and what you're planning.</p>
          </div>
          <div style="text-align:center; border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.75rem 1.25rem;">
            <div class="font-display" style="font-size:1.875rem; color:#c9b4a0; margin-bottom:0.5rem;">2</div>
            <h3 style="font-size:14px; font-weight:500; color:#3d2e1e; margin-bottom:0.375rem;">Discovery call</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">15 minutes. We walk through the property, answer questions, and talk pricing.</p>
          </div>
          <div style="text-align:center; border:1px solid #e8ddd4; border-radius:0.5rem; padding:1.75rem 1.25rem;">
            <div class="font-display" style="font-size:1.875rem; color:#c9b4a0; margin-bottom:0.5rem;">3</div>
            <h3 style="font-size:14px; font-weight:500; color:#3d2e1e; margin-bottom:0.375rem;">Custom proposal</h3>
            <p style="font-size:13px; color:#8a6f5a; line-height:1.375;">Within 48 hours: photos, pricing, and availability tailored to your dates and group.</p>
          </div>
        </div>
      </section>

      <!-- ============================================================
