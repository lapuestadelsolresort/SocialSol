<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lapuestadelsolresort.gtku</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SOCIALSOL_ROOT__/crm/scripts/gtku-daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__SOCIALSOL_ROOT__/memory/gtku-log.txt</string>
  <key>StandardErrorPath</key>
  <string>__SOCIALSOL_ROOT__/memory/gtku-log.txt</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
