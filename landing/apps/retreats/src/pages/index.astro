---
/**
 * La Puesta del Sol — Corporate Retreat Landing Page
 * retreats.lapuestadelsolresort.com
 *
 * Targeting: SF Bay Area corporate retreat planners
 * CTA: WhatsApp to Sarah
 * UTM: utm_source=email&utm_campaign=sf_corporate_retreat_2026
 */
import '../styles/global.css'

const WHATSAPP_URL = 'https://wa.me/15553526612?text=' + encodeURIComponent(
  "Hi Sarah, I'm interested in hosting a corporate retreat at La Puesta del Sol. Could we set up a quick call?"
);

const CRM_WEBHOOK = 'https://webhook.lapuestadelsolresort.com/webhook/pixel';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Corporate Retreats at La Puesta del Sol — Private Resort, Riviera Nayarit</title>
  <meta name="description" content="Full-resort buyout for corporate retreats in Riviera Nayarit, Mexico. 22 bedrooms, sport court, infinity pool, private chef. 45 min from Puerto Vallarta. Groups of 15–35." />
  <meta property="og:title" content="Corporate Retreats at La Puesta del Sol" />
  <meta property="og:description" content="Private beachfront resort buyout in Riviera Nayarit. Sport court, infinity pool, chef-prepared meals, 22 bedrooms. 45 min from Puerto Vallarta." />
  <meta property="og:image" content="/images/food-ocean.jpg" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://retreats.lapuestadelsolresort.com" />
  <link rel="canonical" href="https://retreats.lapuestadelsolresort.com" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Meta Pixel -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '837757775519925');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=837757775519925&ev=PageView&noscript=1" /></noscript>

  <!-- Landing-page variant optimizer (WhatsApp-click funnel) — scripts served by the CRM -->
  <script is:inline>
    window.LPDS_BASE = 'https://webhook.lapuestadelsolresort.com';
    window.LPDS_PAGE = 'retreats';
  </script>
  <script is:inline defer src="https://webhook.lapuestadelsolresort.com/lp/px.js?v=8"></script>
  <script is:inline defer src="https://webhook.lapuestadelsolresort.com/lp/hydrate.js?v=7"></script>

  <style is:global>
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      color: #2C2C2A;
      background: #FAF8F5;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
  </style>
</head>

<body>
  <nav class="absolute top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-12 py-4">
    <a href="https://lapuestadelsolresort.com" class="homepage-link text-white/70 hover:text-white text-sm font-medium transition-colors" data-cta="nav_homepage_click" data-event="nav_homepage_click">← La Puesta del Sol</a>
    <div class="flex gap-4 text-[11px] tracking-[2px] uppercase text-white/40">
      <a href="https://weddings.lapuestadelsolresort.com" class="hover:text-white/70 transition-colors">Weddings</a>
      <a href="https://dining.lapuestadelsolresort.com" class="hover:text-white/70 transition-colors">Dining</a>
    </div>
  </nav>

  <!-- ============================================================
       HERO — video background (pool), fallback to hero image
       ============================================================ -->
  <header class="relative w-full h-[85vh] min-h-[600px] max-h-[900px] overflow-hidden bg-stone-900">
    <video
      class="absolute inset-0 w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      poster="/images/hero.jpg"
    >
      <source src="/video/pool.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>

    <div class="absolute bottom-0 left-0 right-0 px-6 pb-10 md:px-12 md:pb-14 max-w-3xl">
      <p class="text-[11px] tracking-[3px] uppercase text-white/50 mb-2">Corporate Retreats at</p>
      <h1 class="hero-headline font-display text-4xl md:text-5xl text-white font-normal leading-[1.1] mb-3">
        La Puesta del Sol
      </h1>
      <p class="hero-sub text-base text-white/70 mb-8 max-w-lg leading-relaxed">
        Private beachfront resort in Riviera Nayarit, Mexico. Full-property buyout for teams of 15–35. 45 minutes from Puerto Vallarta airport.
      </p>

      <!-- Key facts -->
      <div class="flex flex-wrap gap-6 mb-8">
        <div class="border-l border-white/25 pl-4">
          <div class="text-lg font-medium text-white">22 bedrooms</div>
          <div class="text-[11px] text-white/50 mt-0.5">6 villas + Casa Mirador, full buyout</div>
        </div>
        <div class="border-l border-white/25 pl-4">
          <div class="text-lg font-medium text-white">Sport court + pool</div>
          <div class="text-[11px] text-white/50 mt-0.5">Indoor court, infinity pool, ocean</div>
        </div>
        <div class="border-l border-white/25 pl-4">
          <div class="text-lg font-medium text-white">All-inclusive</div>
          <div class="text-[11px] text-white/50 mt-0.5">Chef, bar, staff — all in</div>
        </div>
      </div>

      <!-- Primary CTA -->
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        class="wa-cta inline-flex items-center gap-2.5 bg-[#25D366] hover:bg-[#1fb855] text-white text-sm font-medium px-7 py-3.5 rounded-lg transition-colors"
        data-cta="hero_whatsapp_click" data-event="hero_whatsapp_click"
      >
        <svg class="w-5 h-5 fill-white shrink-0" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.243-1.21l-.29-.18-3.054.8.82-2.99-.193-.3A7.96 7.96 0 014 12a8 8 0 1116 0 8 8 0 01-8 8z"/></svg>
        Message Us on WhatsApp
      </a>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-6 md:px-12">

    <!-- ============================================================
         WHAT YOU GET
         ============================================================ -->
    <section class="py-16 md:py-20">
      <p class="text-[11px] tracking-[3px] uppercase text-sand-500 mb-3">What you get</p>
      <h2 class="font-display text-3xl md:text-[34px] text-sand-800 font-normal leading-tight mb-5">
        The entire resort is yours
      </h2>
      <p class="text-[15px] text-sand-600 leading-relaxed mb-4 max-w-xl">
        Every retreat here is a full-property buyout. No other guests, no shared spaces, no conference room feel.
        Your team has the whole resort — six private villas, Casa Mirador, infinity pool, sport court, oceanfront terraces,
        and a full staff — for the duration of your stay.
      </p>
      <p class="text-[15px] text-sand-600 leading-relaxed mb-10 max-w-xl">
        Located in La Peñita de Jaltemba on Jaltemba Bay, a quiet fishing village 45 minutes north of Puerto Vallarta
        — far enough to actually disconnect, close enough to get there easily.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="border border-sand-200 rounded-lg p-5">
          <h3 class="text-[15px] font-medium text-sand-800 mb-1">22 bedrooms across 6 villas + Casa Mirador</h3>
          <p class="text-[13px] text-sand-500 leading-snug">Each villa has its own kitchen and bathrooms. Fits teams of 15–35 comfortably.</p>
        </div>
        <div class="border border-sand-200 rounded-lg p-5">
          <h3 class="text-[15px] font-medium text-sand-800 mb-1">Indoor sport court</h3>
          <p class="text-[13px] text-sand-500 leading-snug">Full-size multi-sport court with basketball, plus billiards, darts, and a mezzanine games lounge. Built for team bonding.</p>
        </div>
        <div class="border border-sand-200 rounded-lg p-5">
          <h3 class="text-[15px] font-medium text-sand-800 mb-1">Infinity pool + oceanfront</h3>
          <p class="text-[13px] text-sand-500 leading-snug">Sculpted infinity pool overlooking Jaltemba Bay. Oceanfront terraces and a palapa dining deck built over the rocks.</p>
        </div>
        <div class="border border-sand-200 rounded-lg p-5">
          <h3 class="text-[15px] font-medium text-sand-800 mb-1">Private chef + full F&B</h3>
          <p class="text-[13px] text-sand-500 leading-snug">On-site chef, bartender, and butler. All meals, snacks, and drinks for your group — every day, included.</p>
        </div>
        <div class="border border-sand-200 rounded-lg p-5">
          <h3 class="text-[15px] font-medium text-sand-800 mb-1">Activities + adventure</h3>
          <p class="text-[13px] text-sand-500 leading-snug">On-site adventure guide. Surfing, snorkeling, boat trips, jungle hikes, paddleboarding — all available.</p>
        </div>
        <div class="border border-sand-200 rounded-lg p-5">
          <h3 class="text-[15px] font-medium text-sand-800 mb-1">On-site coordinator</h3>
          <p class="text-[13px] text-sand-500 leading-snug">Dedicated property manager handles everything — logistics, scheduling, local vendor coordination.</p>
        </div>
      </div>
    </section>

    <hr class="border-sand-200" />

    <!-- ============================================================
         SPORT COURT — video feature
         ============================================================ -->
    <section class="py-16 md:py-20">
      <p class="text-[11px] tracking-[3px] uppercase text-sand-500 mb-3">The court</p>
      <h2 class="font-display text-3xl md:text-[34px] text-sand-800 font-normal leading-tight mb-5">
        A full indoor sport court. At a beach resort.
      </h2>
      <p class="text-[15px] text-sand-600 leading-relaxed mb-8 max-w-xl">
        Most beach retreats give you a ping-pong table. We have a full multi-sport court with basketball,
        a billiards lounge, dartboards, and a mezzanine bar. Your team can actually play — and then watch the
        ocean from the terrace.
      </p>
      <div class="rounded-xl overflow-hidden aspect-video bg-stone-900">
        <video
          class="w-full h-full object-cover"
          autoplay
          muted
          loop
          playsinline
        >
          <source src="/video/court.mp4" type="video/mp4" />
        </video>
      </div>
    </section>

    <hr class="border-sand-200" />

    <!-- ============================================================
         FOOD
         ============================================================ -->
    <section class="py-16 md:py-20">
      <p class="text-[11px] tracking-[3px] uppercase text-sand-500 mb-3">Food & drink</p>
      <h2 class="font-display text-3xl md:text-[34px] text-sand-800 font-normal leading-tight mb-5">
        Every meal, included
      </h2>
      <p class="text-[15px] text-sand-600 leading-relaxed mb-8 max-w-xl">
        Your private chef handles breakfast, lunch, dinner, and snacks for your entire group, every day.
        Fresh Pacific seafood, local produce, and dishes that actually compete with the view.
        No catering orders, no separate venue — just food, served where you are.
      </p>
      <div class="grid grid-cols-2 gap-3">
        <img
          src="/images/food-ocean.jpg"
          alt="Chef-prepared seafood tacos with the pool and Pacific Ocean in the background"
          class="w-full aspect-[3/4] object-cover rounded-xl"
          loading="lazy"
        />
        <img
          src="/images/food-chef.jpg"
          alt="Private chef plating dishes in the resort kitchen"
          class="w-full aspect-[3/4] object-cover rounded-xl"
          loading="lazy"
        />
      </div>
    </section>

    <hr class="border-sand-200" />

    <!-- ============================================================
         PRICING
         ============================================================ -->
    <section class="py-16 md:py-20">
      <p class="text-[11px] tracking-[3px] uppercase text-sand-500 mb-3">Pricing</p>
      <h2 class="font-display text-3xl md:text-[34px] text-sand-800 font-normal leading-tight mb-5">
        One number covers everything
      </h2>
      <p class="text-[15px] text-sand-600 leading-relaxed mb-4 max-w-xl">
        Full-property buyout pricing. Lodging, meals, drinks, chef, bar, and staff — all in.
        No per-person F&B charges, no hidden add-ons.
      </p>
      <p class="text-[15px] text-sand-600 leading-relaxed mb-4 max-w-xl">
        A typical 4-night retreat buyout for 20–30 people starts around
        <strong class="text-sand-800">$28,000</strong>.
        Larger groups and peak-season dates run higher. We'll give you an exact number after a 15-minute call.
      </p>
      <p class="text-[13px] text-sand-400 max-w-xl">
        Flights, external facilitators, off-property excursions, and A/V equipment are separate.
        Everything at the resort — including the court, pool, and all food — is included.
      </p>
    </section>

    <hr class="border-sand-200" />

    <!-- ============================================================
         HOW IT WORKS
         ============================================================ -->
    <section class="py-16 md:py-20">
      <p class="text-[11px] tracking-[3px] uppercase text-sand-500 mb-3">How it works</p>
      <h2 class="font-display text-3xl md:text-[34px] text-sand-800 font-normal leading-tight mb-8">
        Three steps
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="text-center border border-sand-200 rounded-lg py-7 px-5">
          <div class="font-display text-3xl text-sand-300 mb-2">1</div>
          <h3 class="text-[14px] font-medium text-sand-800 mb-1.5">Message us</h3>
          <p class="text-[13px] text-sand-500 leading-snug">WhatsApp or email. Share your dates, headcount, and any must-haves.</p>
        </div>
        <div class="text-center border border-sand-200 rounded-lg py-7 px-5">
          <div class="font-display text-3xl text-sand-300 mb-2">2</div>
          <h3 class="text-[14px] font-medium text-sand-800 mb-1.5">Discovery call</h3>
          <p class="text-[13px] text-sand-500 leading-snug">15 minutes. We walk through the property, answer logistics questions, and discuss pricing.</p>
        </div>
        <div class="text-center border border-sand-200 rounded-lg py-7 px-5">
          <div class="font-display text-3xl text-sand-300 mb-2">3</div>
          <h3 class="text-[14px] font-medium text-sand-800 mb-1.5">Custom proposal</h3>
          <p class="text-[13px] text-sand-500 leading-snug">Within 48 hours: full pricing, availability, and a sample schedule tailored to your team.</p>
        </div>
      </div>
    </section>

    <!-- ============================================================
         FOOTER CTA
         ============================================================ -->
    <section class="text-center py-16 md:py-20 border-t border-sand-200">
      <p class="font-display text-2xl md:text-3xl text-sand-800 mb-3">
        Ready to see if we're the right fit?
      </p>
      <p class="text-[14px] text-sand-500 mb-8">
        Most retreat planners know within one call.
      </p>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        class="wa-cta inline-flex items-center gap-2.5 bg-[#25D366] hover:bg-[#1fb855] text-white text-sm font-medium px-7 py-3.5 rounded-lg transition-colors"
        data-cta="footer_whatsapp_click" data-event="footer_whatsapp_click"
      >
        <svg class="w-5 h-5 fill-white shrink-0" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.243-1.21l-.29-.18-3.054.8.82-2.99-.193-.3A7.96 7.96 0 014 12a8 8 0 1116 0 8 8 0 01-8 8z"/></svg>
        Message Us on WhatsApp
      </a>
      <p class="text-[13px] text-sand-400 mt-4">
        Or email: <a href="mailto:sarah@lapuestadelsolresort.com" class="underline hover:text-sand-600">sarah@lapuestadelsolresort.com</a>
      </p>
    </section>
  </main>

  <footer class="text-center py-8 text-[12px] text-sand-400 border-t border-sand-100">
    <p><a href="https://lapuestadelsolresort.com" class="homepage-link text-sand-500 hover:text-sand-700 underline underline-offset-2 transition-colors" data-cta="footer_homepage_click" data-event="footer_homepage_click">La Puesta del Sol</a> · La Peñita de Jaltemba, Riviera Nayarit, Mexico</p>
    <p class="mt-1">45 minutes from Puerto Vallarta International Airport (PVR)</p>
    <p class="mt-3 flex justify-center gap-4 text-[11px]">
      <a href="https://weddings.lapuestadelsolresort.com" class="text-sand-400 hover:text-sand-600 transition-colors">Weddings</a>
      <span>·</span>
      <a href="https://dining.lapuestadelsolresort.com" class="text-sand-400 hover:text-sand-600 transition-colors">Dining</a>
      <span>·</span>
      <a href="https://lapuestadelsolresort.com/contact" class="text-sand-400 hover:text-sand-600 transition-colors">Contact</a>
    </p>
  </footer>

  <!-- Tracking: Meta Pixel Lead on WhatsApp click. Page-view + WhatsApp-click
       telemetry to the CRM is handled by lp/tracker.js (loaded in <head>). -->
  <script is:inline>
    (function() {
      var params = new URLSearchParams(window.location.search);
      ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'].forEach(function(k) {
        var v = params.get(k);
        if (v) sessionStorage.setItem(k, v);
      });
      // Track homepage link clicks
      document.querySelectorAll('.homepage-link').forEach(function(link) {
        link.addEventListener('click', function() {
          var eventName = link.getAttribute('data-event') || 'homepage_click';
          if (typeof fbq === 'function') {
            fbq('trackCustom', 'HomepageClick', { page: 'retreats', location: eventName });
          }
        });
      });

      document.querySelectorAll('.wa-cta').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (typeof fbq === 'function') {
            fbq('trackCustom', 'WhatsAppClick', {
              content_name: 'retreat_whatsapp_click',
              content_category: 'corporate_retreat',
              value: 28000,
              currency: 'USD'
            });
          }
        });
      });
    })();
  </script>
  <!-- FLOATING WHATSAPP BUTTON -->
  <a
    id="wa-float"
    href={WHATSAPP_URL}
    target="_blank"
    rel="noopener"
    class="wa-cta fixed bottom-5 right-5 z-50 flex items-center justify-center w-14 h-14 bg-[#25D366] hover:bg-[#1fb855] rounded-full shadow-lg transition-all hover:scale-110"
    aria-label="Chat on WhatsApp"
  >
    <svg class="w-7 h-7 fill-white" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.243-1.21l-.29-.18-3.054.8.82-2.99-.193-.3A7.96 7.96 0 014 12a8 8 0 1116 0 8 8 0 01-8 8z"/></svg>
  </a>
  <style>
    @keyframes wa-pulse { 0%,100%{box-shadow:0 4px 14px rgba(37,211,102,.4)} 50%{box-shadow:0 4px 24px rgba(37,211,102,.7)} }
    #wa-float { animation: wa-pulse 2s ease-in-out infinite; }
  </style>
</body>
</html>
