<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reengager Regina — daily anniversary cron.
  Fires every day at 09:00 local time.

  Operator install:
    Render this template with scripts/render-launchagents.sh.
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.lapuestadelsolresort.regina-anniversary.plist
    launchctl enable gui/$(id -u)/com.lapuestadelsolresort.regina-anniversary
    launchctl list | grep regina-anniversary

  Run the anniversary script manually before enabling this schedule.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lapuestadelsolresort.regina-anniversary</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__SOCIALSOL_ROOT__/regina/scripts/anniversary-cron.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>SOCIALSOL_ROOT</key>
    <string>__SOCIALSOL_ROOT__</string>
    <key>OPENCLAW_SLACK_ACCOUNT</key>
    <string>__OPENCLAW_SLACK_ACCOUNT__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__SOCIALSOL_ROOT__/regina/logs/anniversary.log</string>
  <key>StandardErrorPath</key>
  <string>__SOCIALSOL_ROOT__/regina/logs/anniversary.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
