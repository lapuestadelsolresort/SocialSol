<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lapuestadelsolresort.job-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>__SOCIALSOL_ROOT__/automation/job_watchdog.py</string>
  </array>
  <key>WorkingDirectory</key><string>__SOCIALSOL_ROOT__</string>
  <key>RunAtLoad</key><false/>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>__SOCIALSOL_ROOT__/logs/job-watchdog.log</string>
  <key>StandardErrorPath</key><string>__SOCIALSOL_ROOT__/logs/job-watchdog.err</string>
</dict>
</plist>
