{
  "version": 1,
  "shadow_mode": true,
  "live_workflows": ["whatsapp.reply", "meta.dm.reply", "email.reply.propose", "email.reply.confirm", "email.message.classify", "marketing.change.confirm", "meta.campaign.autonomous", "marketing.report.daily", "meta.audience.sync", "ownerrez.mutation.confirm", "receipt.ingest", "receipt.process", "receipt.annotate", "receipt.owner_expense.ingest", "receipt.owner_expense.process", "receipt.owner_expense.confirm"],
  "always_on_effects": ["whatsapp.inbound.process:send_conversion"],
  "channels": {
    "REPLACE_WITH_WHATSAPP_CHANNEL_ID": {
      "name": "whatsapp",
      "capabilities": ["whatsapp.read", "whatsapp.send", "crm.read", "crm.write"]
    },
    "REPLACE_WITH_SOCIAL_CHANNEL_ID": {
      "name": "social-sol",
      "capabilities": ["social.read", "social.write", "social.publish", "marketing.read", "marketing.write", "crm.read", "crm.write"]
    },
    "REPLACE_WITH_PROSPECTOR_CHANNEL_ID": {
      "name": "prospector-paulina",
      "capabilities": ["paulina.read", "paulina.run", "paulina.send", "email.read", "email.send", "crm.read", "crm.write"]
    },
    "REPLACE_WITH_SARAH_EMAIL_CHANNEL_ID": {
      "name": "sarah-email",
      "capabilities": ["email.read", "email.send", "crm.read", "crm.write"]
    },
    "REPLACE_WITH_BUSINESS_INTEL_CHANNEL_ID": {
      "name": "business-intel",
      "capabilities": ["business.read_all"]
    },
    "REPLACE_WITH_ACCOUNTING_CHANNEL_ID": {
      "name": "accounting",
      "capabilities": ["accounting.read", "accounting.write", "qbo.read", "qbo.write", "squarespace.read", "receipts.read", "receipts.write", "crm.read"]
    },
    "REPLACE_WITH_RESERVATIONS_CHANNEL_ID": {
      "name": "reservations",
      "capabilities": ["ownerrez.read", "reservations.read", "ownerrez.write"]
    },
    "REPLACE_WITH_OWNER_EXPENSE_CHANNEL_ID": {
      "name": "receipt-owner",
      "capabilities": ["receipts.submit", "receipts.write", "accounting.read_scoped", "qbo.owner_expense.write"]
    }
  },
  "restricted_capabilities": {
    "ownerrez.write": {
      "users": ["REPLACE_WITH_AUTHORIZED_SLACK_USER_ID"]
    },
    "marketing.write": {
      "users": ["REPLACE_WITH_AUTHORIZED_SLACK_USER_ID"]
    },
    "email.send": {
      "users": ["REPLACE_WITH_AUTHORIZED_SLACK_USER_ID"]
    }
  },
  "autonomous_workflows": [
    "whatsapp.inbound.process",
    "email.message.observe",
    "paulina.daily",
    "paulina.prepare_daily",
    "regina.daily",
    "social.publish_routine",
    "social.publish_due",
    "marketing.report.daily",
    "meta.audience.sync",
    "crm.sync",
    "ownerrez.crm.sync",
    "squarespace.crm.sync",
    "ownerrez.webhook.process",
    "accounting.classify",
    "receipt.reconcile",
    "qbo.write"
  ],
  "write_notifications": {
    "user_ids": ["REPLACE_WITH_JASON_SLACK_USER_ID", "REPLACE_WITH_SARAH_SLACK_USER_ID"],
    "channel_ids": []
  }
}
