<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lapuestadelsolresort.graph-paulina</string>
  <key>ProgramArguments</key><array>
    <string>__NODE_BIN__</string><string>__SOCIALSOL_ROOT__/crm/scripts/workflow-trigger.js</string>
    <string>paulina.daily</string><string>--bucket</string><string>5m</string>
  </array>
  <!-- F-064: fixed wall-clock minutes replace StartInterval so the CRM-writing graphs never share a
       write slot (StartInterval phase-aligned every one of them at deploy time). The disjoint-minute
       invariant is enforced by scripts/check-launchagents.py. -->
  <key>StartCalendarInterval</key><array>
    <dict><key>Minute</key><integer>1</integer></dict>
    <dict><key>Minute</key><integer>6</integer></dict>
    <dict><key>Minute</key><integer>11</integer></dict>
    <dict><key>Minute</key><integer>16</integer></dict>
    <dict><key>Minute</key><integer>21</integer></dict>
    <dict><key>Minute</key><integer>26</integer></dict>
    <dict><key>Minute</key><integer>31</integer></dict>
    <dict><key>Minute</key><integer>36</integer></dict>
    <dict><key>Minute</key><integer>41</integer></dict>
    <dict><key>Minute</key><integer>46</integer></dict>
    <dict><key>Minute</key><integer>51</integer></dict>
    <dict><key>Minute</key><integer>56</integer></dict>
  </array>
  <key>RunAtLoad</key><true/>
  <key>WorkingDirectory</key><string>__SOCIALSOL_ROOT__</string>
  <key>StandardOutPath</key><string>__SOCIALSOL_ROOT__/logs/graph-paulina.log</string>
  <key>StandardErrorPath</key><string>__SOCIALSOL_ROOT__/logs/graph-paulina.error.log</string>
</dict></plist>
