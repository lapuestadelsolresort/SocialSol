{
  "name": "socialsol",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing funnel, CRM, landing pages, and automation for La Puesta del Sol Resort",
  "workspaces": [
    "crm",
    "prospector",
    "regina",
    "sarah-coach",
    "landing/apps/*"
  ],
  "scripts": {
    "setup:workflow-token": "node scripts/setup-workflow-control-token.js",
    "configure:receipt-channel": "node scripts/configure-receipt-channel.js",
    "configure:receipt-payments": "node scripts/configure-receipt-payments.js",
    "configure:owner-expense-channel": "node scripts/configure-owner-expense-channel.js",
    "configure:social-autonomy": "node scripts/configure-social-autonomy.js",
    "cutover:social-autonomy": "node scripts/cutover-social-autonomy.js --confirm-production",
    "configure:email-replies": "node scripts/configure-email-replies.js",
    "cutover:email-replies": "node scripts/cutover-email-replies.js --confirm-production",
    "configure:sarah-email": "node scripts/configure-sarah-email.js",
    "cutover:sarah-email": "node scripts/cutover-sarah-email.js --confirm-production",
    "configure:paloma-monitoring": "node scripts/configure-paloma-monitoring.js",
    "reconcile:email-conversations": "node crm/scripts/reconcile-email-conversations.js",
    "reconcile:email-classifications": "node crm/scripts/reconcile-email-classifications.js",
    "reconcile:whatsapp-statuses": "node crm/scripts/reconcile-whatsapp-statuses.js",
    "reconcile:owner-expense": "node scripts/reconcile-owner-expense-receipt.js",
    "test": "npm --workspace crm test",
    "test:prospector": "node --test prospector/lib/*.test.js",
    "test:regina": "node --test regina/lib/*.test.js",
    "test:paloma": "node --test paloma/lib/*.test.js",
    "test:openclaw-plugins": "node --test openclaw-plugins/*/*.test.js scripts/generate-command-docs.test.js scripts/render-openclaw-workflow-policy.test.js scripts/validate-openclaw-shadow.test.js scripts/configure-receipt-channel.test.js scripts/configure-receipt-payments.test.js scripts/configure-owner-expense-channel.test.js scripts/configure-social-autonomy.test.js scripts/cutover-social-autonomy.test.js scripts/configure-email-replies.test.js scripts/cutover-email-replies.test.js scripts/configure-sarah-email.test.js scripts/cutover-sarah-email.test.js scripts/reconcile-owner-expense-receipt.test.js",
    "test:automation": "PYTHONPATH=automation python3 -m unittest discover -s automation/tests -p 'test_*.py'",
    "test:accounting": "python3 -m unittest discover -s accounting -p 'test_*.py'",
    "test:evals": "node --test evals/*.test.js && node evals/run.js --responses evals/responses.fixture.json",
    "test:release": "node --test scripts/production-release.test.js scripts/install-launchagents.test.js scripts/policy-fingerprint.test.js",
    "eval:fixture": "node evals/run.js --responses evals/responses.fixture.json",
    "eval:workflows": "test -n \"$EVAL_RESPONSES_FILE\" && node evals/run.js --responses \"$EVAL_RESPONSES_FILE\"",
    "check:javascript": "node scripts/check-javascript.js",
    "check:python": "python3 -m compileall -q automation accounting",
    "check:shell": "bash scripts/check-shell.sh",
    "check:launchagents": "python3 scripts/check-launchagents.py",
    "check:docs": "node scripts/generate-command-docs.js --check",
    "check:stack": "npm run check:secrets && npm run check:javascript && npm run check:python && npm run check:shell && npm run check:launchagents && npm run check:docs && npm run test:automation && npm run test:accounting && npm run test:evals && npm run test:release && npm test && npm run test:prospector && npm run test:regina && npm run test:paloma && npm run test:openclaw-plugins && npm run build:landing",
    "release:check": "node scripts/production-release.js check",
    "release:deploy": "node scripts/production-release.js deploy --confirm-production",
    "render:launchagents": "node scripts/render-launchagents.js",
    "docs:commands": "node scripts/generate-command-docs.js",
    "render:openclaw-policy": "node scripts/render-openclaw-workflow-policy.js",
    "validate:openclaw-shadow": "node scripts/validate-openclaw-shadow.js",
    "apply:openclaw-shadow": "node scripts/apply-openclaw-shadow.js --confirm-shadow",
    "services:plan": "node scripts/install-launchagents.js plan",
    "services:check": "node scripts/install-launchagents.js check",
    "install:launchagents": "node scripts/install-launchagents.js apply --confirm-production",
    "init:runtime": "bash scripts/init-runtime.sh",
    "migrate:squarespace": "node crm/scripts/migrate-squarespace.js",
    "sync:squarespace": "node crm/scripts/squarespace-sync.js",
    "report:squarespace": "node crm/scripts/squarespace-report.js --all",
    "report:owner-cash-flow": "node crm/scripts/owner-cash-flow.js",
    "workflow:worker": "node crm/scripts/workflow-worker.js",
    "workflow:once": "node crm/scripts/workflow-worker.js --once",
    "workflow:trigger": "node crm/scripts/workflow-trigger.js",
    "build:landing": "npm run build --workspaces --if-present",
    "audit:production": "npm audit --omit=dev",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "brace-expansion": "5.0.9",
    "tar": "7.5.22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
