<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lapuestadelsolresort.lp-phase-gate</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>__SOCIALSOL_ROOT__/automation/lp_phase_gate.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SOCIALSOL_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>RESORT_SOCIAL_CHANNEL</key>
    <string>__RESORT_SOCIAL_CHANNEL__</string>
    <key>OPENCLAW_SLACK_ACCOUNT</key>
    <string>__OPENCLAW_SLACK_ACCOUNT__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__SOCIALSOL_ROOT__/crm/logs/lp-phase-gate.log</string>
  <key>StandardErrorPath</key>
  <string>__SOCIALSOL_ROOT__/crm/logs/lp-phase-gate.log</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
