<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lapuestadelsolresort.tracking-health</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON_BIN__</string><string>__SOCIALSOL_ROOT__/scripts/tracking-health-check.py</string>
  </array>
  <key>WorkingDirectory</key><string>__SOCIALSOL_ROOT__</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>OPENCLAW_SLACK_ACCOUNT</key><string>__OPENCLAW_SLACK_ACCOUNT__</string>
    <key>TRACKING_QC_CHANNEL</key><string>__TRACKING_QC_CHANNEL__</string>
  </dict>
  <key>StandardOutPath</key><string>__SOCIALSOL_ROOT__/logs/tracking-health.log</string>
  <key>StandardErrorPath</key><string>__SOCIALSOL_ROOT__/logs/tracking-health.err</string>
</dict></plist>
