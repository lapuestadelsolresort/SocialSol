<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reengager Regina — daily Gmail reconciliation + re-queue sweep (Phase R5).
  Fires every day at 10:00 local time (1h after the anniversary cron so they
  don't compete for Voice Service capacity).

  Operator install:
    Render this template with scripts/render-launchagents.sh.
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.lapuestadelsolresort.regina-reconcile.plist
    launchctl enable gui/$(id -u)/com.lapuestadelsolresort.regina-reconcile
    launchctl list | grep regina-reconcile

  Manual smoke:
    node __SOCIALSOL_ROOT__/regina/scripts/gmail-reconcile.js
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lapuestadelsolresort.regina-reconcile</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__SOCIALSOL_ROOT__/regina/scripts/gmail-reconcile.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__SOCIALSOL_ROOT__/regina/logs/reconcile.log</string>
  <key>StandardErrorPath</key>
  <string>__SOCIALSOL_ROOT__/regina/logs/reconcile.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
